generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One app = one owner account. Login is the owner's MPIN only — there is
/// no phone number or OTP. The server NEVER sees the MPIN or the encryption
/// key: it stores only a verifier (SHA-256 of the key derived from the MPIN)
/// and the encrypted data blob the phone sends it (end-to-end encryption).
model SyncAccount {
  id        String  @id @default(cuid())
  /// Fixed singleton slot — this deployment belongs to one owner
  slot      String  @unique @default("owner")
  /// Data-encryption key wrapped (AES-GCM) with a key derived from the MPIN
  dekWrapped String?
  /// PBKDF2 salt for the MPIN key — not a secret, needed to unwrap
  dekSalt   String?
  /// SHA-256 of the key derived from the MPIN — proves the MPIN without storing it
  pinVerifier String?
  /// Encrypted snapshot of the whole business data (settings, products, bills, ledger)
  ciphertext  String?
  dataIv      String?
  dataVersion Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  slot      String
  /// whose session this is — 'owner' (MPIN) or 'staff' (username + password)
  role      String      @default("owner")
  /// set when role = 'staff'
  staffId   String?
  expiresAt DateTime
  createdAt DateTime    @default(now())
  account   SyncAccount @relation(fields: [slot], references: [slot], onDelete: Cascade)
}

/// UPI payment confirmations. The business vault is end-to-end encrypted, so
/// the server cannot read the bills — it only records "billRef paid ₹X at T"
/// events that the owner's phone matches against its pending UPI bills.
model PaymentEvent {
  id        String   @id @default(cuid())
  /// matches the UPI QR payment note (e.g. SLP-1731…), set by the bill screen
  billRef   String   @unique
  amount    Float
  /// UPI / Card / Cash — how the money actually arrived
  method    String   @default("UPI")
  /// who reported it: webhook (payment gateway) / owner (manual confirm)
  provider  String   @default("webhook")
  /// WhatsApp dispatch result for the customer notification
  waStatus  String   @default("pending")
  /// SMS dispatch result for the customer notification
  smsStatus String   @default("pending")
  createdAt DateTime @default(now())
}

/// Staff accounts created by the OWNER. Staff sign in with username +
/// password (scrypt-hashed at rest — the password itself is never stored).
/// The data key is re-wrapped under a key derived from the staff password
/// on the OWNER'S device, so staff devices can open the same encrypted
/// vault while the server still never sees any key material in the clear.
model StaffUser {
  id           String   @id @default(cuid())
  slot         String   @default("owner")
  /// login name — unique, lowercase
  username     String   @unique
  /// display name (shown on bills the staff creates)
  name         String
  /// scrypt hash of the password — secure resets replace this
  passwordHash String
  active       Boolean  @default(true)
  /// DEK wrapped (AES-GCM) under a key derived from the staff password
  dekWrapped   String?
  dekIv        String?
  /// PBKDF2 salt for the staff-password key
  dekSalt      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The barcode bill registry — the source of truth for Code 128 bill
/// verification. Every finalized bill registers exactly ONE verification
/// code here (one code per bill, one bill per code — duplicates and reuse
/// are rejected at the database level). Verification ALWAYS reads this
/// table: nothing is trusted from the barcode itself.
model VerifiedBill {
  id            String   @id @default(cuid())
  /// the unique unpredictable verification ID the Code 128 barcode encodes
  code          String   @unique
  /// one code per bill, one bill per code — prevents reuse across bills
  billNo        String   @unique
  slot          String   @default("owner")
  /// company snapshot at bill time (the server never sees settings otherwise)
  companyName   String
  billDateISO   DateTime
  /// display name only — the phone/address are NEVER stored here
  customerName  String
  gstPercent    Float    @default(0)
  gstAmount     Float    @default(0)
  discount      Float    @default(0)
  labourCharge  Float    @default(0)
  autoCharge    Float    @default(0)
  subtotal      Float
  total         Float
  paid          Float    @default(0)
  balance       Float    @default(0)
  paymentMode   String   @default("Cash")
  paymentStatus String   @default("Due")
  /// who billed it — Owner or the staff username
  createdBy     String   @default("Owner")
  /// cancelled bills fail verification with the CANCELLED message
  cancelled     Boolean  @default(false)
  /// bill line items as JSON [{name, size, qty, price, discount}]
  itemsJson     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Every barcode verification attempt — genuine, cancelled or unknown —
/// is logged here so the owner can see a bill's verification history.
model VerificationLog {
  id     String   @id @default(cuid())
  /// the scanned or typed code — may not exist (not_found)
  code   String
  /// valid | cancelled | not_found
  result String
  ip     String?
  at     DateTime @default(now())

  @@index([code])
}
