generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One app = one owner account. Login is the owner's MPIN only — there is
/// no phone number or OTP. The server NEVER sees the MPIN or the encryption
/// key: it stores only a verifier (SHA-256 of the key derived from the MPIN)
/// and the encrypted data blob the phone sends it (end-to-end encryption).
model SyncAccount {
  id        String  @id @default(cuid())
  /// Fixed singleton slot — this deployment belongs to one owner
  slot      String  @unique @default("owner")
  /// Data-encryption key wrapped (AES-GCM) with a key derived from the MPIN
  dekWrapped String?
  /// PBKDF2 salt for the MPIN key — not a secret, needed to unwrap
  dekSalt   String?
  /// SHA-256 of the key derived from the MPIN — proves the MPIN without storing it
  pinVerifier String?
  /// Encrypted snapshot of the whole business data (settings, products, bills, ledger)
  ciphertext  String?
  dataIv      String?
  dataVersion Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  slot      String
  expiresAt DateTime
  createdAt DateTime    @default(now())
  account   SyncAccount @relation(fields: [slot], references: [slot], onDelete: Cascade)
}

/// UPI payment confirmations. The business vault is end-to-end encrypted, so
/// the server cannot read the bills — it only records "billRef paid ₹X at T"
/// events that the owner's phone matches against its pending UPI bills.
model PaymentEvent {
  id        String   @id @default(cuid())
  /// matches the UPI QR payment note (e.g. SLP-1731…), set by the bill screen
  billRef   String   @unique
  amount    Float
  /// UPI / Card / Cash — how the money actually arrived
  method    String   @default("UPI")
  /// who reported it: webhook (payment gateway) / owner (manual confirm)
  provider  String   @default("webhook")
  /// WhatsApp dispatch result for the customer notification
  waStatus  String   @default("pending")
  /// SMS dispatch result for the customer notification
  smsStatus String   @default("pending")
  createdAt DateTime @default(now())
}
